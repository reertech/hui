{
  "name": "svelte-hui",
  "version": "0.0.1",
  "description": "Human User Interface Svelte Components",
  "svelte": "src/index.js",
  "module": "dist/index.mjs",
  "main": "dist/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "rollup -c",
    "prepublishOnly": "npm run build",
    "lint": "eslint --ext .js,.html,.svelte .",
